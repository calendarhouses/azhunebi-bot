TELEGRAM_BOT_TOKEN=your_bot_token_here
WEB_APP_URL=https://azhunebi-menu.vercel.app/azhunebi-menu
WEBHOOK_URL=https://azhunebi-bot-six.vercel.app/api/webhook
ADMIN_TELEGRAM_ID=your_telegram_user_id
# One or more owners (comma-separated, without @). All get admin panel + "Доступ" tab.
OWNER_TELEGRAM_USERNAME=your_username,yankovich_andriy
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
TENANT_ID=3767b167-cc5f-4d4d-ae59-95e8bc6f795b
ALLOWED_ORIGIN=https://azhunebi-menu.vercel.app
# Optional: comma-separated list if menu is also on GitHub Pages
# ALLOWED_ORIGIN=https://azhunebi-menu.vercel.app,https://calendarhouses.github.io
CRON_SECRET=your_random_cron_secret
# Guest ordering requires QR (cabin c0–c12 / table t1–t12). After house checkout, access is revoked.
# Left chat "Меню" button is set via API (JSON-serialized menu_button + t.me/bot/app link).
# After bot deploy: https://azhunebi-bot-six.vercel.app/api/health?repair=1
# menuButton.ok must be true and current.type must be "web_app".
# If not_applied: BotFather → Bot Settings → Menu Button → Open a Web App
#   URL: https://t.me/azhunebifood_bot/app  (or your Mini App HTTPS URL)
# Optional override:
# TELEGRAM_BOT_USERNAME=azhunebifood_bot
# TELEGRAM_MENU_APP_LINK=https://t.me/azhunebifood_bot/app
# Also hide the bot from Telegram search in BotFather (Bot Settings → allow groups / search).
# Optional extra blocks (comma-separated, without @). Hardcoded: alisa2013,jaxxmyyhusband
# BLOCKED_TELEGRAM_USERNAMES=spamuser1,spamuser2
# Optional: skip first-time sticker upload on cold start (run scripts/print-sticker-file-ids.js once)
# STICKER_FILE_ID_HI=CAACAgIAAxkB...
# STICKER_FILE_ID_LOVE=CAACAgIAAxkB...
# STICKER_FILE_ID_EMPTY=CAACAgIAAxkB...
